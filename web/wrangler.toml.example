name = "my-agent"
main = "src/index.ts"
compatibility_date = "2025-12-01"
compatibility_flags = ["nodejs_compat"]

# account_id = "YOUR_ACCOUNT_ID"

[assets]
directory = "./public"
binding = "ASSETS"
not_found_handling = "single-page-application"
run_worker_first = [
  "/api/*",
  "/mcp*",
  "/authorize",
  "/token",
  "/register",
  "/health",
  "/pulse",
  "/dashboard",
  "/chat/ws",
  "/agents/*",
  "/.well-known/*",
  "/webhooks/*"
]

[[d1_databases]]
binding = "DB"
database_name = "my-agent"
# database_id = "YOUR_DATABASE_ID"

[ai]
binding = "AI"

[[durable_objects.bindings]]
name = "CHAT_SESSION"
class_name = "ChatSession"

[[durable_objects.bindings]]
name = "AegisVoiceAdapter"
class_name = "AegisVoiceAdapter"

[[migrations]]
tag = "v1-chat-session"
new_sqlite_classes = ["ChatSession"]

[[migrations]]
tag = "v2-aegis-voice-adapter"
new_sqlite_classes = ["AegisVoiceAdapter"]

# ─── Model Configuration ─────────────────────────────────────
# Override default models at deploy time via vars.
# Secrets (ANTHROPIC_API_KEY, GROQ_API_KEY, etc.) are set via wrangler secret put.
[vars]
# Primary CF Workers AI model — used by the workers_ai executor.
# Must be an active model in the @stackbilt/llm-providers cloudflare catalog.
WORKERS_AI_MODEL = "@cf/meta/llama-3.3-70b-instruct-fp8-fast"

# Triggers — hourly cron for scheduled tasks
[triggers]
crons = ["0 * * * *"]

# ─── Optional Service Bindings ────────────────────────────────
# Uncomment and configure as needed.

# Memory Worker (persistent semantic memory with vector search)
# [[services]]
# binding = "MEMORY"
# service = "your-memory-worker"
# entrypoint = "MemoryService"

# TarotScript (deterministic symbolic reasoning)
# [[services]]
# binding = "TAROTSCRIPT"
# service = "tarotscript-worker"

# ─── Optional: Sandbox task executor ─────────────────────────
# Runs coding tasks in a Cloudflare Sandbox container and opens a pull request
# only after the task's acceptance contract passes. Needs a Workers Paid plan
# (Containers), a Docker-capable build (or deploy from CI), and GITHUB_TOKEN.
# Your Worker must also export the classes:
#   export { Sandbox } from '@stackbilt/aegis-core/factory';
#   export const TaskExecutorDO = createTaskExecutorDO({ homeOrg: 'your-org', gitIdentity: { ... } });
# Guide: docs/sandbox-executor.md. Uncomment all of the following to enable.
#
# [[containers]]
# class_name = "Sandbox"
# image = "./Dockerfile.sandbox"
# instance_type = "basic"
# max_instances = 2
#
# [[durable_objects.bindings]]
# name = "TASK_SANDBOX"
# class_name = "Sandbox"
#
# [[durable_objects.bindings]]
# name = "TASK_EXECUTOR"
# class_name = "TaskExecutorDO"
#
# [[migrations]]
# tag = "v3-task-executor"
# new_sqlite_classes = ["Sandbox", "TaskExecutorDO"]
